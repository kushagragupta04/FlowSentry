# ============================================================
# RealTimeFraudGuard — Environment Configuration
# Copy to .env and fill in real values before running.
# NEVER commit .env to source control.
# ============================================================

# ─── Kafka / Redpanda ───────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
SCHEMA_REGISTRY_URL=http://redpanda:8081
TRANSACTIONS_TOPIC=transactions
FLAGGED_EVENTS_TOPIC=flagged-events
FLAGGED_EVENTS_DLQ_TOPIC=flagged-events-dlq
KAFKA_CONSUMER_GROUP_SCORING=scoring-service-cg
KAFKA_CONSUMER_GROUP_LLM=llm-worker-cg

# ─── Producer ───────────────────────────────────────────────
# Synthetic transaction rate (transactions per second)
PRODUCER_TPS=100
# Fraction of transactions that are synthetic fraud (for training data only)
FRAUD_RATE=0.02

# ─── PostgreSQL ─────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fraudguard
POSTGRES_USER=fraudguard
POSTGRES_PASSWORD=fraudguard_secret
DATABASE_URL=postgresql://fraudguard:fraudguard_secret@postgres:5432/fraudguard

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_FEATURES_TTL_SECONDS=90000     # 25 hours — covers largest window (24hr) + buffer

# ─── MinIO (Flink Checkpoints) ──────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
FLINK_CHECKPOINT_BUCKET=flink-checkpoints
FLINK_SAVEPOINT_BUCKET=flink-savepoints
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123

# ─── Scoring Service ────────────────────────────────────────
SCORING_SERVICE_HOST=0.0.0.0
SCORING_SERVICE_PORT=8000
# Decision thresholds
THRESHOLD_FLAG=0.30
THRESHOLD_BLOCK=0.70
# Business rule thresholds
RULE_MAX_COUNTRIES_10MIN=3
RULE_COUNTRY_MISMATCH_MIN_AMOUNT=500.0

# ─── LLM (Groq) ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192
GROQ_MAX_TOKENS=512
GROQ_TEMPERATURE=0.3
# Cost control: cache LLM responses for identical rule-trigger combinations
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600

# ─── OpenTelemetry ──────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=scoring-service
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus

# ─── Prometheus ─────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=fraudguard_grafana

# ─── Alertmanager ───────────────────────────────────────────
# Local stdout webhook receiver for alert routing
ALERTMANAGER_WEBHOOK_URL=http://webhook-receiver:5001/alert

# ─── Analyst Dashboard ──────────────────────────────────────
DASHBOARD_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8000
